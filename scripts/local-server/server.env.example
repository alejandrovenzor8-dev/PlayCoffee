# Copiar como server.env mediante install-local-server.ps1.
# No guardar el archivo real en Git porque contiene secretos.
PLAYCOFFEE_ROOT=C:\PlayCoffee
PLAYCOFFEE_DATA=C:\ProgramData\PlayCoffee
DATABASE_URL=postgresql://playcoffee:replace_me@localhost:5432/playcoffee
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_with_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_random_secret_min_32_chars
PRINT_AGENT_TOKEN=replace_with_random_agent_secret
PRINT_AGENT_ID=playcoffee-local
PRINT_AGENT_API_URL=http://127.0.0.1:3001/api/v1
PRINT_AGENT_POLL_MS=1000
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
NODE_ENV=production
PORT=3001
FRONTEND_PORT=3000
HTTPS_ENABLED=true
HTTPS_PORT=3443
TLS_PFX_PATH=C:\ProgramData\PlayCoffee\certificates\playcoffee-local-server.pfx
TLS_PFX_PASSWORD=replace_with_generated_password
CORS_ORIGIN=https://192.168.1.50:3443
NEXT_PUBLIC_API_URL=https://192.168.1.50:3443
NEXT_PUBLIC_WS_URL=https://192.168.1.50:3443
